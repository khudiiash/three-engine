{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Three Engine",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 650,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --enable-unsafe-webgpu --force-high-performance-gpu --force_high_performance_gpu --gpu-program-cache-size-kb=262144 --gpu-disk-cache-size-mb=1024",
        "decorations": false
      }
    ]
  }
}
